@model ContactFormModel
@{
    ViewData["Title"] = "Contact";
    var sent = ViewBag.Success as bool?;
}

<section class="contact">
    <p class="section-title">Contact</p>
    <form asp-controller="Contact" asp-action="Contact" method="post" class="form" novalidate>
        <div class="field-row">
            <div class="field">
                <label asp-for="Name">Nom</label>
                <input asp-for="Name" placeholder="Ton nom" autocomplete="name">
                <span asp-validation-for="Name" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Email">E-mail</label>
                <input asp-for="Email" placeholder="toi@exemple.fr" autocomplete="email">
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
        </div>
        <div class="field">
            <label asp-for="Message">Message</label>
            <textarea asp-for="Message" rows="6" placeholder="Raconte-moi ton projet…"></textarea>
            <span asp-validation-for="Message" class="field-error"></span>
        </div>
        <div class="form-foot">
            <p class="status-msg @(sent == true ? "ok" : sent == false ? "err" : "")" role="status">@ViewBag.Message</p>
            <button class="btn" type="submit">Envoyer</button>
        </div>
    </form>
</section>
