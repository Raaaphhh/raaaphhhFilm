@model ErrorViewModel
@{
    ViewData["Title"] = "Erreur";
}

<section class="error-page">
    <h1>Coupez ! Une erreur est survenue.</h1>
    <p>La page n'a pas pu être chargée. <a asp-controller="Home" asp-action="Index">Retour à l'accueil</a></p>

    @if (Model.ShowRequestId)
    {
        <p class="status-msg">Request ID : <code>@Model.RequestId</code></p>
    }
</section>
