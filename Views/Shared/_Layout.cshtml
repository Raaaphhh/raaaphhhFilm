@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="theme-color" content="#0a0a0a"/>
    <title>@ViewData["Title"] — raaaphhhFilm</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<div class="grain" aria-hidden="true"></div>

<header>
    <nav class="topbar">
        <span class="rec" aria-hidden="true"><span class="rec-dot"></span>REC <span id="tc">00:00:00:00</span></span>
        <div class="nav-links">
            <a asp-controller="Home" asp-action="Index" class="@(controller == "Home" ? "active" : "")">Index</a>
            <a asp-controller="Contact" asp-action="Contact" class="@(controller == "Contact" ? "active" : "")">Contact</a>
            <a href="https://raaaphhh.dev/" target="_blank" rel="noopener" title="Mon site de développeur">Dev&nbsp;&#8599;</a>
        </div>
    </nav>

    <div class="me">
        <img src="~/img/logo_raph.png" alt="Raphaël Descamps" class="profile-logo">
        <div>
            <p class="me-name">raaaphhhFilm</p>
            <p class="me-role">Raphaël Descamps</p>
        </div>
    </div>
</header>

<main role="main">
    @RenderBody()
</main>

<footer>
    <p>© @DateTime.Now.Year raaaphhhFilm</p>
    <div class="footer-links">
        <a href="https://github.com/Raaaphhh" target="_blank" rel="noopener">GitHub</a>
        <a href="https://www.linkedin.com/in/descamps-raphael/" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://raaaphhh.dev/" target="_blank" rel="noopener">raaaphhh.dev</a>
    </div>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
