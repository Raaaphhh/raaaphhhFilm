@{
    ViewData["Title"] = "Index";
    var videos = ViewBag.Videos as Dictionary<string, (string Url, bool IsPrivate, string CodeSecret)>;
    var codeValid = (bool)ViewBag.CodeValid;
    var codeSubmitted = Context.Request.Method == "POST";

    var publicVideos = videos!.Where(v => !v.Value.IsPrivate).Select(v => (Title: v.Key, Id: YoutubeId(v.Value.Url))).ToList();
    var privateVideos = videos!.Where(v => v.Value.IsPrivate).Select(v => (Title: v.Key, Id: YoutubeId(v.Value.Url))).ToList();
    var featured = publicVideos.FirstOrDefault();
}

@functions {
    // "https://www.youtube.com/embed/{id}?si=..." -> "{id}"
    private static string YoutubeId(string url)
    {
        var id = url.Split("/embed/").Last();
        var end = id.IndexOfAny(new[] { '?', '&', '/' });
        return end >= 0 ? id[..end] : id;
    }
}

@if (featured != default)
{
    <section class="featured">
        <div class="section-head">
            <p class="section-title">À la une</p>
            <span class="section-meta">Dernière sortie</span>
        </div>
        <button class="clip" type="button" data-video="@featured.Id" data-title="@featured.Title">
            <div class="frame">
                <img src="https://i.ytimg.com/vi/@featured.Id/maxresdefault.jpg"
                     onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/@featured.Id/hqdefault.jpg'"
                     alt="">
                <div class="frame-hud"><span class="hud-tc">HD</span><span class="hud-play">▶ LECTURE</span></div>
                <div class="big-play"><span><svg width="18" height="18" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"/></svg></span></div>
            </div>
            <div class="featured-caption">
                <span class="featured-title">@featured.Title</span>
                <span class="tag">YouTube</span>
            </div>
        </button>
    </section>
}

<section class="films" data-view="grid">
    <div class="section-head">
        <p class="section-title">Filmographie</p>
        <div class="view-toggle" role="group" aria-label="Affichage">
            <button type="button" data-set-view="grid" aria-pressed="true">Grille</button>
            <button type="button" data-set-view="list" aria-pressed="false">Liste</button>
        </div>
    </div>

    <div class="grid">
        @foreach (var video in publicVideos.Skip(1))
        {
            <button class="clip" type="button" data-video="@video.Id" data-title="@video.Title">
                <div class="frame">
                    <img src="https://i.ytimg.com/vi/@video.Id/hqdefault.jpg" alt="" loading="lazy">
                    <div class="frame-hud"><span class="hud-tc">HD</span><span class="hud-play">▶ LECTURE</span></div>
                </div>
                <div class="clip-caption">
                    <span class="clip-title">@video.Title</span>
                    <span class="clip-arrow">&#8599;</span>
                </div>
            </button>
        }
    </div>

    <div class="list">
        @for (var i = 0; i < publicVideos.Count; i++)
        {
            var video = publicVideos[i];
            <button class="clip row" type="button" data-video="@video.Id" data-title="@video.Title">
                <span class="row-idx">@((publicVideos.Count - i).ToString("00"))</span>
                <span class="row-title">@video.Title</span>
                <img class="row-thumb" src="https://i.ytimg.com/vi/@video.Id/mqdefault.jpg" alt="" loading="lazy">
            </button>
        }
    </div>
</section>

@if (privateVideos.Any())
{
    <section id="prive">
        <div class="section-head">
            <p class="section-title">Accès privé</p>
            <span class="section-meta">
                @(codeValid ? "Déverrouillé" : $"{privateVideos.Count} film{(privateVideos.Count > 1 ? "s" : "")} verrouillé{(privateVideos.Count > 1 ? "s" : "")}")
            </span>
        </div>

        <div class="private-grid">
            @if (codeValid)
            {
                foreach (var video in privateVideos)
                {
                    <button class="clip" type="button" data-video="@video.Id" data-title="@video.Title">
                        <div class="frame">
                            <img src="https://i.ytimg.com/vi/@video.Id/hqdefault.jpg" alt="" loading="lazy">
                            <div class="frame-hud"><span class="hud-tc">PRIVÉ</span><span class="hud-play">▶ LECTURE</span></div>
                        </div>
                        <div class="clip-caption">
                            <span class="clip-title">@video.Title</span>
                            <span class="clip-arrow">&#8599;</span>
                        </div>
                    </button>
                }
            }
            else
            {
                @* Ni titre ni ID YouTube dans la page tant que le code n'est pas validé *@
                for (var i = 0; i < privateVideos.Count; i++)
                {
                    <div class="clip locked">
                        <div class="frame">
                            <div class="lock-badge">
                                <div>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                                    PRIVÉ
                                </div>
                            </div>
                        </div>
                        <div class="clip-caption">
                            <span class="clip-title">Film privé @(i + 1)</span>
                            <span class="clip-arrow">—</span>
                        </div>
                    </div>
                }
            }
        </div>

        @if (!codeValid)
        {
            <form method="post" action="@Url.Action("Index", "Home")#prive" class="unlock @(codeSubmitted ? "shake" : "")" autocomplete="off">
                <label for="Code" class="sr-only">Code d'accès</label>
                <input id="Code" name="Code" type="tel" inputmode="numeric" pattern="[0-9]*" placeholder="Code d'accès" required>
                <button class="btn" type="submit">Déverrouiller</button>
            </form>
            <p class="status-msg @(codeSubmitted ? "err" : "")">
                @(codeSubmitted ? "Code incorrect. Vérifie les chiffres et réessaie." : "Entre le code pour débloquer les vidéos privées.")
            </p>
        }
        else
        {
            <p class="status-msg ok">Accès accordé · @privateVideos.Count film@(privateVideos.Count > 1 ? "s" : "") ajouté@(privateVideos.Count > 1 ? "s" : "").</p>
        }
    </section>
}

<dialog id="player" aria-label="Lecteur vidéo">
    <div class="player">
        <div class="frame">
            <iframe id="player-iframe" title="Lecteur YouTube"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen></iframe>
            <div class="letterbox" id="player-bars"></div>
        </div>
        <div class="player-bar">
            <span class="player-title" id="player-title"></span>
            <div class="player-actions">
                <a id="player-link" href="#" target="_blank" rel="noopener">Ouvrir sur YouTube&nbsp;&#8599;</a>
                <button class="player-close" type="button" id="player-close">ESC</button>
            </div>
        </div>
    </div>
</dialog>
